<clickhouse>
    <logger>
        <level>error</level>
        <console>1</console>
    </logger>
    <!-- Every listener is one of the service's port slots (enve.cue): the declared one in enve's
         default instance, a free one in a named instance (E7), as the server's $PORT_<SLOT>. -->
    <http_port from_env="PORT"/>
    <tcp_port from_env="PORT_NATIVE"/>
    <interserver_http_port from_env="PORT_INTERSERVER"/>
    <listen_host>127.0.0.1</listen_host>
    <listen_host>::1</listen_host>

    <max_server_memory_usage>0</max_server_memory_usage>
    <mark_cache_size>67108864</mark_cache_size>

    <!-- The test databases (posthog_test_shardN) persist in the data dir between runs, unlike upstream's fresh
         CI container. With asynchronous loading, a test dropping one before its startup job ran cancels that job,
         and 'startup ddl worker' (which depends on every database) fails: every ON CLUSTER query then errors with
         ASYNC_LOAD_CANCELED for the rest of the server's life. Load them synchronously at startup. -->
    <async_load_databases>false</async_load_databases>

    <!-- @DATA_DIR@ and @ROOT@ are the instance's data dir and the checkout, which the service's command
         writes in when it renders this file: a named instance's data dir lies deeper than .enve/data. -->
    <path>@DATA_DIR@/</path>
    <tmp_path>@DATA_DIR@/tmp/</tmp_path>
    <user_files_path>@DATA_DIR@/user_files/</user_files_path>

    <!-- The repo's UDFs (JSONDropKeys, aggregate_funnel, ...), as upstream loads them, from posthog/user_scripts.
         Outside CI the code calls the unversioned names, which docker/clickhouse/user_defined_function.xml defines
         (compose mounts it); under CI (`is_ci()`) it calls the versioned ones (JSONDropKeys_v12), which upstream's
         CI copies in from posthog/user_scripts/latest_user_defined_function.xml. Both are loaded, so either mode
         runs. -->
    <user_defined_executable_functions_config>@ROOT@/docker/clickhouse/user_defined_function.xml</user_defined_executable_functions_config>
    <user_defined_executable_functions_config>@ROOT@/posthog/user_scripts/latest_user_defined_function.xml</user_defined_executable_functions_config>
    <user_scripts_path>@ROOT@/posthog/user_scripts/</user_scripts_path>

    <!-- As docker/clickhouse/config.xml: a scheduler pool larger than the ~95 Kafka engine tables
         (else their consumers starve and the MVs stall), and its merge pool. -->
    <max_connections>4096</max_connections>
    <max_concurrent_queries>200</max_concurrent_queries>
    <background_message_broker_schedule_pool_size>128</background_message_broker_schedule_pool_size>
    <max_thread_pool_size>10000</max_thread_pool_size>
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>8</background_merges_mutations_concurrency_ratio>
    <!-- A dropped table's data and its replica's keeper path go at once, not 8 minutes later: a
         prod-like migrate_clickhouse (run_mcp_integration.sh) creates and drops replicated
         tables at fixed keeper paths (0049's log_entries, 0144 drops it), so its next run
         within the delay found the replica still there (REPLICA_ALREADY_EXISTS). -->
    <database_atomic_delay_before_drop_table_sec>0</database_atomic_delay_before_drop_table_sec>

    <merge_tree>
        <max_bytes_to_merge_at_max_space_in_pool>1073741824</max_bytes_to_merge_at_max_space_in_pool>
        <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
    </merge_tree>

    <query_log>
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>500</flush_interval_milliseconds>
    </query_log>

    <query_thread_log>
        <database>system</database>
        <table>query_thread_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </query_thread_log>

    <!-- docker/clickhouse/config.xml's: migration 0159's custom_metrics_server_crash view reads
         it, so a prod-like migrate_clickhouse (run_mcp_integration.sh) needs it to exist, made by
         SYSTEM FLUSH LOGS as upstream's init-db.sh does. -->
    <crash_log>
        <database>system</database>
        <table>crash_log</table>
        <partition_by />
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </crash_log>

    <!-- docker/clickhouse/config.xml's: the backup dags (posthog/dags/backups.py) read each
         BACKUP's status from it; test_backups' four backups failed without it. -->
    <backup_log>
        <database>system</database>
        <table>backup_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <ttl>event_date + INTERVAL 5 DAY</ttl>
        <ttl_only_drop_parts>1</ttl_only_drop_parts>
    </backup_log>

    <macros>
        <shard>01</shard>
        <replica>ch1</replica>
        <hostClusterType>online</hostClusterType>
        <hostClusterRole>data</hostClusterRole>
    </macros>

    <keeper_server>
        <tcp_port from_env="PORT_KEEPER"/>
        <server_id>1</server_id>
        <log_storage_path>@DATA_DIR@/keeper/log</log_storage_path>
        <snapshot_storage_path>@DATA_DIR@/keeper/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>error</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>127.0.0.1</hostname>
                <port from_env="PORT_RAFT"/>
            </server>
        </raft_configuration>
    </keeper_server>

    <zookeeper>
        <node>
            <host>127.0.0.1</host>
            <port from_env="PORT_KEEPER"/>
        </node>
    </zookeeper>

    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>

    <!-- As docker/clickhouse/config.d/default.xml: the Kafka clusters the Kafka engine tables
         name (CLICKHOUSE_KAFKA_*_NAMED_COLLECTION), all on the one broker. Without them the
         nodejs setup's setup_test_environment (only-clickhouse) fails to create them.
         Each also gives its tables' consumers a 3 s group session (librdkafka's default is 45 s;
         the global <kafka> section doesn't reach a named collection's tables): a DROP TABLE leaves
         its consumer in the group without a LeaveGroup, and every later consumer of that group
         (group1 is most tables', in every worker's database) waits for it to expire before it
         gets a partition. ee's test_dead_letter_queue drops its Kafka table after each test
         and test_kafka_insert waits 10 s for its message. enve.cue lowers the broker's minimum. -->
    <named_collections>
        <msk_cluster>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
            <kafka><session_timeout_ms>3000</session_timeout_ms><heartbeat_interval_ms>1000</heartbeat_interval_ms></kafka>
        </msk_cluster>
        <warpstream_ingestion>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
            <kafka><session_timeout_ms>3000</session_timeout_ms><heartbeat_interval_ms>1000</heartbeat_interval_ms></kafka>
        </warpstream_ingestion>
        <warpstream_calculated_events>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
            <kafka><session_timeout_ms>3000</session_timeout_ms><heartbeat_interval_ms>1000</heartbeat_interval_ms></kafka>
        </warpstream_calculated_events>
        <warpstream_replay>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
            <kafka><session_timeout_ms>3000</session_timeout_ms><heartbeat_interval_ms>1000</heartbeat_interval_ms></kafka>
        </warpstream_replay>
        <warpstream_shared>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
            <kafka><session_timeout_ms>3000</session_timeout_ms><heartbeat_interval_ms>1000</heartbeat_interval_ms></kafka>
        </warpstream_shared>
        <warpstream_cyclotron>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
            <kafka><session_timeout_ms>3000</session_timeout_ms><heartbeat_interval_ms>1000</heartbeat_interval_ms></kafka>
        </warpstream_cyclotron>
        <warpstream_logs>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
            <kafka><session_timeout_ms>3000</session_timeout_ms><heartbeat_interval_ms>1000</heartbeat_interval_ms></kafka>
        </warpstream_logs>
        <warpstream_traces>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
            <kafka><session_timeout_ms>3000</session_timeout_ms><heartbeat_interval_ms>1000</heartbeat_interval_ms></kafka>
        </warpstream_traces>
        <warpstream_metrics>
            <kafka_broker_list from_env="KAFKA_HOSTS"/>
            <kafka><session_timeout_ms>3000</session_timeout_ms><heartbeat_interval_ms>1000</heartbeat_interval_ms></kafka>
        </warpstream_metrics>
    </named_collections>

    <remote_servers>
        <posthog>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port from_env="PORT_NATIVE"/>
                </replica>
            </shard>
        </posthog>
        <posthog_single_shard>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port from_env="PORT_NATIVE"/>
                </replica>
            </shard>
        </posthog_single_shard>
        <posthog_migrations>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port from_env="PORT_NATIVE"/>
                </replica>
            </shard>
        </posthog_migrations>
        <posthog_writable>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port from_env="PORT_NATIVE"/>
                </replica>
            </shard>
        </posthog_writable>
        <posthog_primary_replica>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port from_env="PORT_NATIVE"/>
                </replica>
            </shard>
        </posthog_primary_replica>
        <ai_events>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port from_env="PORT_NATIVE"/>
                </replica>
            </shard>
        </ai_events>
        <aux>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port from_env="PORT_NATIVE"/>
                </replica>
            </shard>
        </aux>
        <ops>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port from_env="PORT_NATIVE"/>
                </replica>
            </shard>
        </ops>
        <sessions>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port from_env="PORT_NATIVE"/>
                </replica>
            </shard>
        </sessions>
    </remote_servers>

    <!-- Users, profiles and quotas: upstream's own (compose mounts users-dev.xml as users.xml), so
         the session settings the code and tests rely on (insert_distributed_sync, compatibility,
         stream_flush_interval_ms for the Kafka engine, optimize_empty_string_comparisons ...) track
         upstream. A copy here had drifted: the Kafka tables flushed every 7.5s instead of 100ms
         and Distributed inserts were async, so the nodejs ingestion e2e suites timed out. users.xml is
         start.sh's link to docker/clickhouse/users-dev.xml: the server merges users.d/ beside it, where
         start.sh puts this platform's overrides (users.d/darwin.xml). -->
    <user_directories>
        <users_xml>
            <path>@DATA_DIR@/users.xml</path>
        </users_xml>
        <local_directory>
            <path>@DATA_DIR@/access/</path>
        </local_directory>
    </user_directories>
</clickhouse>
